<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0B0F14</color>
    <style name="Theme.HeadUnit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Launch theme: swapped for Theme.HeadUnit by installSplashScreen() -->
    <style name="Theme.HeadUnit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HeadUnit</item>
    </style>
</resources>
